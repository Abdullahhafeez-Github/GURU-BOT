{
  "manifest_version": 3,
  "name": "Universal Copy Tool",
  "description": "Save CSS selectors and copy matching content from any webpage.",
  "version": "1.0.0",
  "action": {
    "default_title": "Universal Copy",
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}